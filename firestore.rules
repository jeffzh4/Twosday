rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsAccount(username) {
      return signedIn()
        && exists(/databases/$(database)/documents/accounts/$(username))
        && get(/databases/$(database)/documents/accounts/$(username)).data.ownerUid == request.auth.uid;
    }

    function validAccount(data) {
      return data.ownerUid is string
        && data.profiles is list
        && data.profiles.size() == 2
        && data.firestoreDoc is string
        && data.notesDoc is string;
    }

    // Shallow shape and size validation. Firestore rules cannot walk nested
    // maps, so per-event fields stay client-validated — but these caps stop a
    // buggy or hostile client from growing a document without bound (the 1 MiB
    // document limit would otherwise be the only backstop, and hitting it
    // bricks the account's sync).
    function validCalendarShape(data) {
      return data.allData is map
        && data.allData.size() <= 1500
        && (!data.keys().hasAny(['auditLog']) || (data.auditLog is list && data.auditLog.size() <= 300))
        && (!data.keys().hasAny(['tombstones']) || data.tombstones is map);
    }

    function validScheduleShape(data) {
      return (data.keys().hasAny(['allData']) && validCalendarShape(data))
        || (data.keys().hasAny(['notes']) && data.notes is map && data.notes.size() <= 8)
        || (data.keys().hasAny(['sessions']) && data.sessions is map && data.sessions.size() <= 30);
    }

    function linkedScheduleDocument(docId, data) {
      let account = get(/databases/$(database)/documents/accounts/$(data.accountId)).data;
      return ownsAccount(data.accountId)
        && (
          (data.keys().hasAny(['allData']) && data.allData is map && account.firestoreDoc == docId)
          || (data.keys().hasAny(['notes']) && data.notes is map && account.notesDoc == docId)
          || (data.keys().hasAny(['sessions']) && data.sessions is map && account.firestoreDoc + '-presence' == docId)
        );
    }

    function validOwnedSchedule(docId, data) {
      return signedIn()
        && data.ownerUid == request.auth.uid
        && data.accountId is string
        && validScheduleShape(data)
        && linkedScheduleDocument(docId, data);
    }

    function validShare(data) {
      return data.ownerUid is string
        && data.event is map
        && data.event.title is string
        && data.event.dateKey is string
        && data.event.start is number
        && data.event.end is number
        && data.createdAt is number
        && data.expiresAt is number;
    }

    function validShareToken(token) {
      return token.size() == 22 && token.matches('^[0-9a-z]{22}$');
    }

    // Read-only public share links. A share document is a flattened copy of one
    // event, never a pointer into the owner's calendar, so an anonymous reader
    // learns nothing beyond what the sender chose to publish.
    //
    // `get` is public because the token in the URL is the only credential a
    // recipient has. `list` stays denied: without it the collection cannot be
    // enumerated, so the 22-character token remains the only way in.
    match /shares/{token} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && validShareToken(token)
        && request.resource.data.ownerUid == request.auth.uid
        && validShare(request.resource.data);
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && validShare(request.resource.data);
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // Account metadata is isolated by Firebase Auth UID. Usernames remain the
    // document IDs so uniqueness can be enforced by Firestore itself.
    match /accounts/{username} {
      allow create: if signedIn()
        && validAccount(request.resource.data)
        && request.resource.data.ownerUid == request.auth.uid;
      allow read, delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && validAccount(request.resource.data);
    }

    match /schedules/{docId} {
      // A previous version stored all account metadata in one document. A
      // document-level rule cannot expose one user's fields without exposing
      // every user's fields, so this retired registry is denied to all clients.
      allow read, write: if docId == 'accounts' && false;

      allow create: if docId != 'accounts'
        && validOwnedSchedule(docId, request.resource.data);
      allow read, delete: if docId != 'accounts'
        && signedIn()
        && resource.data.ownerUid == request.auth.uid;
      allow update: if docId != 'accounts'
        && validOwnedSchedule(docId, request.resource.data)
        && (
          resource.data.ownerUid == request.auth.uid
          || !resource.data.keys().hasAny(['ownerUid'])
        );
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
